                    "Text": "#include <stdio.h>\n\nint main(void)\n{\n    char s[] = \"Hello, world!\";\n\n    for (int i = 0; i < 13; i++)\n        printf(\"%c\", s[i]);\n    printf(\"\\n\");\n}"
                  }
                ],
                "status": "Success"
              }
