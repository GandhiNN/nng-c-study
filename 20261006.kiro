        "content": {
          "ToolUseResults": {
            "tool_use_results": [
              {
                "tool_use_id": "toolu_bdrk_01PoSEp8dKyppU94H4s7VaVr",
                "content": [
                  {
                    "Json": {
                      "exit_status": "0",
                      "stdout": "  ~/.profile loaded [vi mode]\nArray size per call     : 400000 bytes\nCalls each              : 20000\n\nby value (full copy)    : 0.255 sec\nby pointer (address)    : 0.123 sec\n\nby-value was 2.1x slower",
                      "stderr": ""
                    }
                  }
